# StockSense environment variables
# Copy this file to .env and fill in values — never commit .env

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://stocksense:localpass@localhost:5432/stocksense

# ── JWT ───────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ACCESS_EXPIRE_MINUTES=
JWT_REFRESH_EXPIRE_DAYS=

# ── App ───────────────────────────────────────────────────
APP_ENV=development

# ── SMTP (Email) ──────────────────────────────────────────
# Leave SMTP_USER and SMTP_PASSWORD blank for local Mailhog
SMTP_HOST=localhost
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=noreply@stocksense.com
