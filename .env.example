# StockSense environment variables
# Copy this file to .env and fill in values — never commit .env

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://stocksense:localpass@localhost:5432/stocksense

# ── JWT ───────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_this_to_a_random_secret_before_running
JWT_ACCESS_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_DAYS=7

# ── App ───────────────────────────────────────────────────
APP_ENV=development
